# --- Visual Studio Internal & Cache Directories ---
.vs/

# --- Build Outputs & Binaries ---
[Dd]ebug/
[Rr]elease/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Aa][Rr][Mm]64[Ee][Cc]/
x64/
x86/
bin/
bin-int/
obj/
out/
bld/

